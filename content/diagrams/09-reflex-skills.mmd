  START["/reflex-start<br/>set up or update,<br/>first screen"] --> REPORT{"Five-part report:<br/>Result?"}
  COVER["/reflex-cover<br/>one screen,<br/>its own branch"] --> REPORT
  CHECK["/reflex-check<br/>parity check<br/>before a merge"] --> REPORT
  REPORT -- "PASS" --> MERGE["Merge the<br/>reflex branch"]
